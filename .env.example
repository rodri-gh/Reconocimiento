# ==========================================
# CONFIGURACIÓN (copia a .env y rellena)
# ==========================================

# PocketBase (admin/superuser)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=tu_admin@pocketbase.com
POCKETBASE_ADMIN_PASSWORD=tu_password_segura

# Clave Fernet para encriptar contraseñas RTSP.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REEMPLAZAR_POR_CLAVE_FERNET

# API del backend
API_HOST=0.0.0.0
API_PORT=8000

# Detector (Fase 2)
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
DETECT_EVERY=3
EVENT_COOLDOWN=5.0
ENABLE_OCR=true
# Ruta a un modelo YOLO detector de placas. El proyecto incluye uno en backend/models/license_plate.pt
PLATE_MODEL=backend/models/license_plate.pt
